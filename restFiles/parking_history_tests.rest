  "observaciones": "Vehículo parqueado en zona B, día completo"
}

### Obtener todos los registros de Parking History
GET http://localhost:3000/api/parking-history

### Obtener un registro por ID (idint)
# Reemplaza 1 con un idint válido del response anterior
GET http://localhost:3000/api/parking-history/1

### Buscar registros por término en observaciones o placa
GET http://localhost:3000/api/parking-history/search?term=zona

### Actualizar un registro por ID
# Reemplaza 1 con un idint válido
PUT http://localhost:3000/api/parking-history/1
Content-Type: application/json

{
  "placa": "ABC123",
  "check_in": "2024-11-28T08:00:00Z",
  "check_out": "2024-11-28T14:00:00Z",
  "licensePlate": "ABC123",
  "cost": 15.00,
  "observaciones": "Vehículo parqueado en zona A, tiempo extendido"
}

### Eliminar un registro por ID
# Reemplaza 2 con un idint válido
DELETE http://localhost:3000/api/parking-history/2
